---
import Base from '../layouts/Base.astro'
import Heroe from '../components/secciones/Heroe.astro'
import Ofrece from '../components/secciones/Ofrece.astro'
import UltimoAviso from '../components/secciones/UltimoAviso.astro'
import ComoLlegar from '../components/secciones/ComoLlegar.astro'
import { cargarDatos } from '../lib/datos'
const d = await cargarDatos()
---
<Base titulo="Casino de Pimentel" descripcion="Club social de socios frente al malecón de Pimentel, Chiclayo: piscina, tenis, básquet, el bar El Astillero y ambientes para eventos. Socios: carnet y reservas desde el celular.">
  <Heroe />
  <Ofrece horarios={d.horarios} tenis={d.tenis} />
  <UltimoAviso avisos={d.avisos} />
  <ComoLlegar horarios={d.horarios} />
</Base>
