---
import Base from '../layouts/Base.astro'
---
<Base titulo="Página no encontrada" descripcion="La página que buscas no existe en el sitio del Casino de Pimentel.">
  <section class="seccion">
    <div class="contenedor" style="display:grid;gap:18px;max-width:720px">
      <h1 class="titulo-seccion">No encontramos esta página</h1>
      <p class="bajada">Puede que el enlace esté mal escrito. Vuelve al inicio o entra a la app del socio.</p>
      <div class="acciones"><a class="pill-btn primario" href="/">Ir al inicio</a><a class="pill-btn secundario" href="/app/ingresar">Soy socio</a></div>
    </div>
  </section>
</Base>
