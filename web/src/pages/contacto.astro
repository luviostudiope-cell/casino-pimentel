---
import Base from '../layouts/Base.astro'
import Icono from '../components/Icono.astro'
import { CLUB, cargarDatos } from '../lib/datos'
const d = await cargarDatos()
---
<Base titulo="Contacto" descripcion="Dirección, teléfonos y horario del Casino de Pimentel: Calle Manuel Seoane 725, Pimentel, Chiclayo. Teléfono 074-425244, celular 920 349 713.">
  <section class="seccion">
    <div class="contenedor rejilla" style="align-items:start">
      <div style="display:grid;gap:16px">
        <span class="pill">Contacto</span>
        <h1 class="titulo-seccion" style="font-size:clamp(2.4rem,5.4vw,3.6rem)">Estamos frente al malecón</h1>
        <p class="bajada">Llámanos para consultas de socios, alquiler de ambientes o información del club.</p>
        <div class="acciones">
          <a class="pill-btn primario" href={CLUB.mapa} target="_blank" rel="noopener"><Icono nombre="MapPin" size={20} /><span>Abrir en Google Maps</span></a>
          <a class="pill-btn secundario" href="tel:074425244"><Icono nombre="Phone" size={20} /><span>Llamar</span></a>
        </div>
      </div>
      <dl class="tarjeta dato-lista">
        <div><dt><Icono nombre="MapPin" /><span>Dirección</span></dt><dd>{CLUB.direccion}</dd></div>
        <div><dt><Icono nombre="Phone" /><span>Teléfono</span></dt><dd><a href="tel:074425244">{CLUB.telefono}</a></dd></div>
        <div><dt><Icono nombre="Smartphone" /><span>Celular</span></dt><dd><a href="tel:+51920349713">{CLUB.celular}</a></dd></div>
        <div><dt><Icono nombre="MessageCircle" /><span>WhatsApp</span></dt><dd>{CLUB.whatsapp}</dd></div>
        <div><dt><Icono nombre="Clock" /><span>Horario</span></dt><dd>{d.horarios.club}</dd></div>
      </dl>
    </div>
  </section>
</Base>
