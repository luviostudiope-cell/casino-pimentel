    <linearGradient id="mar" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4C8ED3" /><stop offset="1" stop-color="#1B4F8F" /></linearGradient>
    <linearGradient id="arena" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F1E6D2" /><stop offset="1" stop-color="#E3D2B4" /></linearGradient>
    <radialGradient id="sol" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#FFF4D6" /><stop offset="1" stop-color="#FFF4D6" stop-opacity="0" /></radialGradient>
  </defs>
  <rect width="800" height="600" fill="url(#cielo)" />
  <circle cx="610" cy="250" r="150" fill="url(#sol)" />
  <circle cx="610" cy="250" r="42" fill="#FFE7B0" />
  <path d="M0 318 L800 300 L800 470 L0 470 Z" fill="url(#mar)" />
  <g stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.5" fill="none">
    <path d="M40 345 q30 -8 60 0 t60 0" /><path d="M260 362 q30 -8 60 0 t60 0" /><path d="M520 340 q30 -8 60 0 t60 0" /><path d="M120 398 q40 -10 80 0 t80 0" /><path d="M560 410 q40 -10 80 0 t80 0" />
