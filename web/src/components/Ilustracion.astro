  <g>
    <path d="M150 440 L800 332 L800 344 L150 456 Z" fill="#6E5232" />
    <g stroke="#4E3A22" stroke-width="5">
      <line x1="190" y1="452" x2="190" y2="476" /><line x1="290" y1="436" x2="290" y2="460" /><line x1="390" y1="419" x2="390" y2="442" /><line x1="490" y1="402" x2="490" y2="424" />
