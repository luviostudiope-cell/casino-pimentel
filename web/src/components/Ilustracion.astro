  <g fill="#B8925C" stroke="#8C6D45" stroke-width="2">
    <path d="M70 545 C 110 470, 140 440, 168 420 C 160 452, 140 500, 104 552 Z" />
    <path d="M120 552 C 160 478, 192 448, 220 428 C 212 460, 192 508, 156 558 Z" />
    <path d="M190 560 C 226 492, 256 462, 282 444 C 276 474, 258 516, 224 564 Z" />
  </g>
  <g stroke="#8C6D45" stroke-width="1.5" opacity="0.6">
    <path d="M86 540 L150 440" /><path d="M136 548 L202 448" /><path d="M206 556 L266 462" />
  </g>
</svg>
